   "source": [
    "# HAI 2025 Deepfake Challenge - Colab Training Notebook\n",
    "이 노트북은 EfficientNet-B5 모델을 FaceForensics++ 데이터셋으로 학습시킵니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Kaggle API 설정 (kaggle.json 파일 업로드 필요)\n",
    "import os\n",
    "from google.colab import files\n",
    "\n",
    "if not os.path.exists('kaggle.json'):\n",
    "    print(\"📢 업로드 버튼을 눌러 'kaggle.json' 파일을 선택해주세요!\")\n",
    "    files.upload()\n",
    "\n",
    "!mkdir -p ~/.kaggle\n",
    "!cp kaggle.json ~/.kaggle/\n",
    "!chmod 600 ~/.kaggle/kaggle.json\n",
    "\n",
    "# 2. 데이터 다운로드 (140k Real & Fake Faces)\n",
    "print(\"⬇️ Downloading Dataset...\")\n",
    "if not os.path.exists('140k-real-and-fake-faces'):\n",
    "    !kaggle datasets download -d xhlulu/140k-real-and-fake-faces\n",
    "    !unzip -q 140k-real-and-fake-faces.zip -d 140k-real-and-fake-faces\n",
    "    !rm 140k-real-and-fake-faces.zip\n",
    "\n",
    "# 3. 라이브러리 설치\n",
    "print(\"📦 Installing Libraries...\")\n",
    "!pip install -q timm albumentations facenet-pytorch\n",
    "\n",
    "# 4. 프로젝트 구조 생성\n",
    "os.makedirs('src/data', exist_ok=True)\n",
    "os.makedirs('src/models', exist_ok=True)\n",
    "os.makedirs('src/trainer', exist_ok=True)\n",
    "os.makedirs('configs', exist_ok=True)\n",
    "os.makedirs('data/submission', exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. 파일 생성 (Config, Code)\n",
    "\n",
    "# configs/base_config.yaml\n",
    "with open('configs/base_config.yaml', 'w') as f:\n",
    "    f.write(\"""\n",
    "project_name: \"HAI_Colab\"\n",
    "experiment_name: \"effnet_b5_colab\"\n",
    "data:\n",
    "  train_dir: \"140k-real-and-fake-faces/real_vs_fake/real-vs-fake\"\n",
    "  val_dir: \"140k-real-and-fake-faces/real_vs_fake/real-vs-fake\"\n",
    "  img_size: 224\n",
    "  batch_size: 32\n",
    "  num_workers: 2\n",
    "model:\n",
    "  backbone: \"efficientnet_b5\"\n",
    "  pretrained: true\n",
    "  num_classes: 2\n",
    "  dropout: 0.3\n",
    "train:\n",
    "  epochs: 7\n",
    "  lr: 0.0001\n",
    "  weight_decay: 1e-4\n",
    "  scheduler: \"CosineAnnealingLR\"\n",
    "  min_lr: 1e-6\n",
    "  device: \"cuda\"\n",
    "  save_dir: \"checkpoints\"\n",
    ""\")\n",
    "\n",
    "# src/data/dataset.py\n",
    "with open('src/data/dataset.py', 'w') as f:\n",
    "    f.write(\"""\n",
    "import os\n",
    "import cv2\n",
    "import glob\n",
    "import torch\n",
    "from torch.utils.data import Dataset\n",
    "\n",
    "class DeepFakeDataset(Dataset):\n",
    "    def __init__(self, root_dir, transform=None, mode='train'):\n",
    "        self.root_dir = root_dir\n",
    "        self.transform = transform\n",
    "        self.mode = mode\n",
    "        \n",
    "        target_dir = os.path.join(root_dir, mode if mode != 'val' else 'valid')\n",
    "        if not os.path.exists(target_dir): target_dir = root_dir # Fallback\n",
    "            \n",
    "        real_paths = glob.glob(os.path.join(target_dir, 'real', '*.jpg'))\n",
    "        fake_paths = glob.glob(os.path.join(target_dir, 'fake', '*.jpg'))\n",
    "        \n",
    "        self.image_paths = real_paths + fake_paths\n",
    "        self.labels = [0]*len(real_paths) + [1]*len(fake_paths)\n",
    "        print(f\"[{mode}] Loaded {len(self.image_paths)} images.\")\n",
    "\n",
    "    def __len__(self): return len(self.image_paths)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        path = self.image_paths[idx]\n",
    "        label = self.labels[idx]\n",
    "        try:\n",
    "            image = cv2.imread(path)\n",
    "            image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
    "            if self.transform: image = self.transform(image=image)['image']\n",
    "            return image, label\n",
    "        except:\n",
    "            return torch.zeros((224,224,3)).numpy(), label\n",
    ""\")\n",
    "\n",
    "# src/models/model.py\n",
    "with open('src/models/model.py', 'w') as f:\n",
    "    f.write(\"""\n",
    "import timm\n",
    "import torch.nn as nn\n",
    "class DeepFakeClassifier(nn.Module):\n",
    "    def __init__(self, backbone='efficientnet_b5', pretrained=True, num_classes=2, dropout=0.3):\n",
    "        super().__init__()\n",
    "        self.model = timm.create_model(backbone, pretrained=pretrained, num_classes=num_classes, drop_rate=dropout)\n",
    "    def forward(self, x): return self.model(x)\n",
    ""\")\n",
    "\n",
    "# src/trainer/train.py\n",
    "with open('src/trainer/train.py', 'w') as f:\n",
    "    f.write(\"""\n",
    "import os\n",
    "import yaml\n",
    "import argparse\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import DataLoader\n",
    "from tqdm import tqdm\n",
    "import albumentations as A\n",
    "from albumentations.pytorch import ToTensorV2\n",
    "from torch.cuda.amp import GradScaler, autocast\n",
    "from src.models.model import DeepFakeClassifier\n",
    "from src.data.dataset import DeepFakeDataset\n",
    "\n",
    "def train(config_path):\n",
    "    with open(config_path, 'r') as f: config = yaml.safe_load(f)\n",
    "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "    print(f\"Using device: {device}\")\n",
    "    \n",
    "    img_size = config['data']['img_size']\n",
    "    train_transform = A.Compose([\n",
    "        A.Resize(img_size, img_size),\n",
    "        A.HorizontalFlip(p=0.5),\n",
    "        A.ImageCompression(quality_lower=60, quality_upper=100, p=0.5),\n",
    "        A.GaussNoise(p=0.1),\n",
    "        A.Normalize(), ToTensorV2()\n",
    "    ])\n",
    "    val_transform = A.Compose([A.Resize(img_size, img_size), A.Normalize(), ToTensorV2()])\n",
    "\n",
    "    train_dataset = DeepFakeDataset(config['data']['train_dir'], transform=train_transform, mode='train')\n",
    "    val_dataset = DeepFakeDataset(config['data']['val_dir'], transform=val_transform, mode='val')\n",
    "    \n",
    "    train_loader = DataLoader(train_dataset, batch_size=config['data']['batch_size'], shuffle=True, num_workers=2)\n",
    "    val_loader = DataLoader(val_dataset, batch_size=config['data']['batch_size'], shuffle=False, num_workers=2)\n",
    "\n",
    "    model = DeepFakeClassifier(backbone=config['model']['backbone'], pretrained=True).to(device)\n",
    "    optimizer = optim.AdamW(model.parameters(), lr=float(config['train']['lr']))\n",
    "    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=config['train']['epochs'])\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    scaler = GradScaler()\n",
    "    \n",
    "    os.makedirs(config['train']['save_dir'], exist_ok=True)\n",
    "    best_acc = 0.0\n",
    "\n",
    "    for epoch in range(config['train']['epochs']):\n",
    "        model.train()\n",
    "        train_loss = 0.0\n",
    "        pbar = tqdm(train_loader, desc=f\"Epoch {epoch+1}\")\n",
    "        for images, labels in pbar:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "            optimizer.zero_grad()\n",
    "            with autocast():\n",
    "                outputs = model(images)\n",
    "                loss = criterion(outputs, labels)\n",
    "            scaler.scale(loss).backward()\n",
    "            scaler.step(optimizer)\n",
    "            scaler.update()\n",
    "            train_loss += loss.item()\n",
    "            pbar.set_postfix({'loss': train_loss / (len(train_loader)+1)})\n",
    "        \n",
    "        scheduler.step()\n",
    "        \n",
    "        model.eval()\n",
    "        correct=0; total=0\n",
    "        with torch.no_grad():\n",
    "            for images, labels in val_loader:\n",
    "                images, labels = images.to(device), labels.to(device)\n",
    "                outputs = model(images)\n",
    "                _, predicted = torch.max(outputs.data, 1)\n",
    "                total += labels.size(0)\n",
    "                correct += (predicted == labels).sum().item()\n",
    "        acc = 100 * correct / total\n",
    "        print(f\"Validation Accuracy: {acc:.2f}%\")\n",
    "        \n",
    "        if acc > best_acc:\n",
    "            best_acc = acc\n",
    "            torch.save(model.state_dict(), f\"{config['train']['save_dir']}/effnet_b5_best.pt\")\n",
    "            print(\"Saved Best Model\")\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    train('configs/base_config.yaml')\n",
    """")
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. 학습 실행\n",
    "print(\"🚀 Starting Training...\")\n",
    "!PYTHONPATH=. python src/trainer/train.py"
   ]
  }
